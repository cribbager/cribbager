# Cribbager production environment. Copy to /usr/local/etc/cribbager/env (install.sh does
# this for you), owner _cribbager, mode 600. NEVER commit the real file.
#
# Format: KEY=VALUE, one per line. It is parsed, not run by a shell: no quoting is
# needed, and `$`, `&`, `;` in a value are literal. Comments must be on their own line.

# --- database (install.sh generates the password and creates the role/database) ---
# Unix socket in the service prefix; the password must be URL-safe (hex).
DATABASE_URL=postgres://cribbager:@GENERATE_DB_PASSWORD@@/cribbager?host=/usr/local/cribbager/run&sslmode=disable

# --- web ---
SECURE_COOKIES=1
# Your public origin (install.sh fills this from DOMAIN=...)
BASE_URL=https://@DOMAIN@
# REQUIRED in production: gates /stats and /metrics behind "Authorization: Bearer <token>".
# Unset means both are public. install.sh generates one.
STATS_TOKEN=@GENERATE_STATS_TOKEN@

# --- password-reset email (optional; leave SMTP_HOST empty and reset links are only logged) ---
# Any SMTP provider; see deploy/macos/docs/email.md. Resend: smtp.resend.com / 587 / resend / re_...
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# An address on a domain your provider has verified; a display name is fine.
SMTP_FROM=Cribbager <noreply@@DOMAIN@>

# --- Cloudflare Tunnel (the tunnel token from the Cloudflare dashboard) ---
TUNNEL_TOKEN=CHANGE_ME

# --- backups ---
# age PUBLIC key (age1...). The private key must live off this machine.
AGE_RECIPIENT=CHANGE_ME
# Optional overrides:
# BACKUP_DIR=/usr/local/cribbager/backups
# BACKUP_KEEP_DAYS=30
# BACKUP_KEEP_MIN=7
# Optional off-machine sync, run after each successful backup ($BACKUP_FILE is the new file)
# BACKUP_POST_CMD=rsync -a "$BACKUP_DIR"/ backup-host:/srv/cribbager-backups/
