<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.cribbager.backup</string>
	<key>UserName</key>
	<string>@SVC_USER@</string>
	<key>GroupName</key>
	<string>@SVC_USER@</string>
	<key>ProgramArguments</key>
	<array>
		<string>@LIBEXEC@/backup.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>CRIBBAGER_PREFIX</key>
		<string>@PREFIX@</string>
		<key>CRIBBAGER_ENV</key>
		<string>@ENV_FILE@</string>
		<key>CRIBBAGER_BREW</key>
		<string>@BREW@</string>
		<key>HOME</key>
		<string>@PREFIX@/home</string>
		<key>PATH</key>
		<string>@BREW@/bin:/usr/local/go/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>@PREFIX@</string>
	<key>StandardOutPath</key>
	<string>@LOGDIR@/backup.log</string>
	<key>StandardErrorPath</key>
	<string>@LOGDIR@/backup.log</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>3</integer>
		<key>Minute</key>
		<integer>15</integer>
	</dict>
	<key>LowPriorityIO</key>
	<true/>
	<key>Nice</key>
	<integer>10</integer>
</dict>
</plist>
